{
  // Varredura do VS Code segue symlink e ignora o .gitignore (--follow --no-ignore).
  // Um `z: -> /` de prefixo wine dentro do projeto fecha um ciclo que a listagem
  // percorre para sempre — o processo de extensões cresceu até 3,9 GB por causa
  // disso. O HOME do container agora mora em ~/.cache/atelier, mas estas exclusões
  // seguram qualquer reaparecimento.
  "files.exclude": {
    "**/.docker-home": true
  },
  "search.exclude": {
    "**/.docker-home": true,
    "**/dist": true,
    "**/out": true
  },
  "files.watcherExclude": {
    "**/.docker-home/**": true,
    "**/dist/**": true,
    "**/out/**": true,
    "**/node_modules/**": true
  }
}
