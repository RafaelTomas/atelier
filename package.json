{
  "name": "atelier",
  "version": "0.1.0",
  "description": "Atelier — canvas de orquestração multi-agente para macOS, Windows e Linux",
  "main": "./out/main/index.js",
  "author": {
    "name": "Eduardo Tasso",
    "email": "etasso@gmail.com"
  },
  "contributors": [
    {
      "name": "Rafael Tomás Souza dos Santos",
      "email": "rafael.tomas@mv.com.br"
    },
    {
      "name": "Brendson Victor",
      "email": "brendson.dev@gmail.com"
    }
  ],
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "demo": "node scripts/make-demo-workspace.mjs && npm run dev",
    "dev:realdata": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-native-deps.mjs",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack:win:docker": "npm run build && node scripts/pack-win-docker.mjs",
    "pack:linux": "npm run build && electron-builder --linux",
    "icon": "node scripts/make-icon.cjs",
    "test:codec": "node scripts/test-codec.mjs",
    "test:clock": "node scripts/test-clock.mjs",
    "test:codex-rollout": "node scripts/test-codex-rollout.mjs",
    "test:data-table": "node scripts/test-data-table.mjs",
    "test:image": "node scripts/test-image.mjs",
    "test:smoke": "node scripts/smoke-headless.mjs",
    "test:git": "node scripts/test-git.mjs && node scripts/test-git-hook.mjs",
    "test:minimap": "node scripts/test-minimap.mjs",
    "test:groups": "node scripts/test-groups.mjs",
    "test:vault": "node scripts/test-vault.mjs",
    "test:editor": "node scripts/test-editor.mjs",
    "test:claude-accounts": "node scripts/test-claude-accounts.mjs",
    "test:codex-protocol": "node scripts/test-codex-protocol.mjs",
    "test:ask": "node scripts/test-ask.mjs",
    "test:recruit": "node scripts/test-recruit.mjs",
    "test:tokens": "node scripts/test-tokens.mjs",
    "test:monitor": "node scripts/test-monitor.mjs",
    "test:session": "node scripts/test-session-resume.mjs",
    "test:spawn": "node scripts/test-spawn-reentrante.mjs",
    "test:todo": "node scripts/test-todo.mjs",
    "test:node": "node scripts/test-node.mjs",
    "test:android-emulator": "node scripts/test-android-emulator.mjs",
    "test:plans": "node scripts/test-plans.mjs",
    "test:task-ui": "node scripts/test-task-ui.mjs",
    "test:placement": "node scripts/test-placement.mjs",
    "test:focus": "node scripts/test-focus.mjs",
    "test:undo": "node scripts/test-undo-delete.mjs",
    "test:artesao": "node scripts/test-artesao.mjs",
    "test:brief": "node scripts/test-brief.mjs",
    "test:waiting": "node scripts/test-waiting.mjs",
    "test:eval-harness": "node scripts/test-eval-harness.mjs",
    "test:css-order": "node scripts/test-css-order.mjs",
    "test:enter": "node scripts/test-enter-separado.mjs",
    "test:vocabulario": "node scripts/test-vocabulario.mjs",
    "test:skill-docs": "node scripts/test-skill-docs.mjs",
    "test:demo": "node scripts/test-demo-workspace.mjs",
    "test": "npm run test:codec && npm run test:clock && npm run test:data-table && npm run test:image && npm run test:git && npm run test:minimap && npm run test:groups && npm run test:vault && npm run test:editor && npm run test:claude-accounts && npm run test:codex-protocol && npm run test:codex-rollout && npm run test:recruit && npm run test:ask && npm run test:tokens && npm run test:monitor && npm run test:session && npm run test:spawn && npm run test:todo && npm run test:node && npm run test:android-emulator && npm run test:plans && npm run test:task-ui && npm run test:placement && npm run test:focus && npm run test:undo && npm run test:artesao && npm run test:brief && npm run test:waiting && npm run test:eval-harness && npm run test:css-order && npm run test:enter && npm run test:vocabulario && npm run test:skill-docs && npm run test:demo && npm run test:smoke"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.1.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
