{
  "name": "atelier",
  "version": "0.1.0",
  "description": "Atelier — canvas de orquestração multi-agente para macOS, Windows e Linux",
  "main": "./out/main/index.js",
  "author": "Atelier contributors",
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "dev": "ATELIER_HOME=$HOME/.atelier-dev electron-vite dev",
    "dev:realdata": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps && node scripts/fix-native-deps.mjs",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack:linux": "npm run build && electron-builder --linux",
    "test:codec": "node scripts/test-codec.mjs",
    "test:smoke": "node scripts/smoke-headless.mjs",
    "test": "npm run test:codec && npm run test:smoke"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "esbuild": "^0.21.0"
  }
}
