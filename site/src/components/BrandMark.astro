---
/**
 * A marca do Atelier — o mesmo símbolo do ícone do app.
 *
 * Vive num componente porque aparece em três lugares (nav e rodapé da landing,
 * cabeçalho da doc) e o gradiente precisa de um `id` único por instância: dois
 * `linearGradient` com o mesmo id na mesma página fazem o segundo ser ignorado.
 */
interface Props {
  /** Sufixo do id do gradiente. Único por instância na mesma página. */
  id: string;
  size?: number;
}

const { id, size = 26 } = Astro.props;
const gradId = `brand-grad-${id}`;
---

<svg width={size} height={size} viewBox="0 0 1024 1024" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id={gradId} x1="24" y1="100" x2="100" y2="20" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#2E7BF6"></stop>
      <stop offset="1" stop-color="#3BD44A"></stop>
    </linearGradient>
  </defs>
  <rect x="100" y="100" width="824" height="824" rx="184" fill="#0e0f12"></rect>
  <rect x="101.5" y="101.5" width="821" height="821" rx="182.5" fill="none" stroke="#2A3341" stroke-width="3"></rect>
  <g transform="translate(236 216) scale(4.9)" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <g stroke={`url(#${gradId})`} stroke-width="11">
      <path d="M28 94 L60 28 L92 94"></path>
      <path d="M42 68 L78 68"></path>
    </g>
    <circle cx="28" cy="94" r="5.5" fill="#2E7BF6"></circle>
    <circle cx="92" cy="94" r="5.5" fill="#3BD44A"></circle>
  </g>
</svg>

<style>
  svg {
    display: block;
    flex: none;
  }
</style>
