---
/**
 * Diagrama nó → cabo → nó, o motivo gráfico central do produto — mesma
 * curva e gradiente azul→verde do `.cable-visual` da landing.
 */
interface Props {
  de?: string;
  para?: string;
}
const { de = 'Editor', para = 'Claude' } = Astro.props;
const gradId = `cabo-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="atelier-cabo">
  <svg viewBox="0 0 300 300" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
    <defs>
      <linearGradient id={gradId} x1="60" y1="70" x2="240" y2="230" gradientUnits="userSpaceOnUse">
        <stop offset="0" stop-color="#2E7BF6"></stop>
        <stop offset="1" stop-color="#3BD44A"></stop>
      </linearGradient>
    </defs>
    <path
      d="M0 60 H300 M0 120 H300 M0 180 H300 M0 240 H300 M60 0 V300 M120 0 V300 M180 0 V300 M240 0 V300"
      stroke="var(--grid)"
      stroke-width="1"
    ></path>
    <path d="M70,80 C 140,60 150,220 235,220" fill="none" stroke={`url(#${gradId})`} stroke-width="3" stroke-linecap="round"
    ></path>
    <circle cx="70" cy="80" r="7" fill="var(--surface)" stroke="#2E7BF6" stroke-width="2.5"></circle>
    <circle cx="235" cy="220" r="7" fill="var(--surface)" stroke="#3BD44A" stroke-width="2.5"></circle>
    <rect x="30" y="55" width="90" height="50" rx="8" fill="var(--surface-2)" stroke="var(--border)"></rect>
    <text x="75" y="85" text-anchor="middle" fill="var(--text)" font-family="ui-monospace,monospace" font-size="11" font-weight="600">{de}</text>
    <rect x="195" y="195" width="90" height="50" rx="8" fill="var(--surface-2)" stroke="var(--border)"></rect>
    <text x="240" y="225" text-anchor="middle" fill="var(--text)" font-family="ui-monospace,monospace" font-size="11" font-weight="600">{para}</text>
  </svg>
</div>

<style>
  .atelier-cabo {
    position: relative;
    aspect-ratio: 1 / 1;
    max-width: 360px;
    margin: 1.5rem auto;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-xl);
  }
</style>
