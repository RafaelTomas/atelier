---
/**
 * Cabeçalho da doc — override do Header do Starlight.
 *
 * Reproduz o `.nav` da landing (SiteNav): marca | links | busca + CTA
 * "Baixar". Busca e Baixar são as duas ações da barra (uma leva a um estado,
 * a outra a uma página) e por isso ficam juntas no canto direito extremo,
 * separadas dos links de navegação por um espaço maior — em vez de misturadas
 * no mesmo grupo, como estava antes. O grid do fim do arquivo é o do
 * Starlight original (mantém a barra alinhada com sidebar/TOC); o que muda é
 * o miolo.
 */
import Search from 'virtual:starlight/components/Search';
import config from 'virtual:starlight/user-config';
import BrandMark from './BrandMark.astro';
import ThemeToggle from './ThemeToggle.astro';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

/** Base com uma barra só: `BASE_URL` já vem com ou sem, dependendo da config. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <a href={siteTitleHref} class="site-title sl-flex" translate="no">
      <BrandMark id="docs-nav" size={26} />
      <span>Atelier</span>
    </a>
  </div>

  <div class="sl-flex print:hidden right-group">
    <div class="actions">
      {shouldRenderSearch && <Search />}
      <ThemeToggle />
      <a class="docs-cta" href={`${base}/download`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        Baixar
      </a>
      <a class="icon-link" href="https://github.com/br3nds0n/atelier" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 .5C5.73.5.5 5.73.5 12c0 5.1 3.29 9.4 7.86 10.94.57.1.79-.25.79-.55v-2.1c-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.2-1.49 3.18-1.18 3.18-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.42.36.78 1.07.78 2.15v3.19c0 .3.21.66.8.55C20.21 21.39 23.5 17.09 23.5 12 23.5 5.73 18.27.5 12 .5Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  /* Marca igual à da landing: texto claro, não azul (o azul é do Starlight). */
  .site-title {
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .site-title span {
    overflow: hidden;
  }

  .right-group {
    align-items: center;
  }

  /* Tudo que é ação (não navegação de página) fica junto no canto direito
     extremo: GitHub, busca e Baixar. */
  .actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  /* O botão de busca do Starlight (`site-search button`) já tem sua própria
     pastilha em site.css — aqui só garante que ele não estica no flex. */
  .actions :global(site-search) {
    flex: none;
  }

  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: var(--r-md);
    color: var(--text-dim);
  }
  .icon-link:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  /* Parte do `.btn.btn-primary` da landing (site.css não é carregado na doc,
     então o botão é redeclarado aqui), com mais presença: sombra no tom do
     accent para separar do resto da barra, que é toda de superfície neutra,
     e um leve "afundar" no active para dar resposta ao clique. */
  .docs-cta {
    display: inline-flex;
    align-items: center;
    flex: none;
    gap: 7px;
    border-radius: var(--r-md);
    font-weight: 600;
    font-size: 13px;
    padding: 8px 15px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2), 0 0 0 1px rgb(0 122 255 / 0.25),
      0 4px 14px rgb(0 122 255 / 0.28);
    transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .docs-cta svg {
    flex: none;
  }
  .docs-cta:hover {
    background: #1a86ff;
    color: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2), 0 0 0 1px rgb(0 122 255 / 0.35),
      0 6px 18px rgb(0 122 255 / 0.4);
  }
  .docs-cta:active {
    background: #0968d6;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2), 0 0 0 1px rgb(0 122 255 / 0.35);
    transform: translateY(1px);
  }

  @media (max-width: 72rem) {
    .actions {
      gap: 0.6rem;
    }
  }

  @media (max-width: 50rem) {
    /* O botão de menu do Starlight é `position: fixed` no canto direito; sem
       reservar o espaço dele, os links passariam por baixo. */
    .right-group {
      margin-inline-end: calc(var(--sl-menu-button-size) + 0.5rem);
    }
  }

  /* ---- daqui para baixo é o grid do Header original do Starlight ---- */
  @media (min-width: 50rem) {
    :global(:root[data-has-sidebar]) {
      --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
    }
    :global(:root:not([data-has-toc])) {
      --__toc-width: 0rem;
    }
    .header {
      --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
      --__main-column-fr: calc(
        (
            100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
              (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
              var(--sl-content-width)
          ) / 2
      );
      display: grid;
      grid-template-columns:
        minmax(
          calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
          auto
        )
        1fr;
      align-content: center;
    }
    /* Só há dois filhos diretos (título e ações) — o grid original do
       Starlight tinha 3 colunas para caber uma busca central entre título e
       ações; sem ela, o .right-group deve ir para a última coluna e ficar
       colado à direita, não esticado por todo o "1fr" do meio. */
    .right-group {
      grid-column: 2;
      justify-content: flex-end;
    }
  }
</style>
