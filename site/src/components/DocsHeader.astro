---
/**
 * Cabeçalho da doc — override do Header do Starlight.
 *
 * Existe para a doc ter a MESMA barra da landing: mesma altura, mesmo vidro
 * fosco, mesma marca, mesmos links. O grid do fim do arquivo é o do Starlight
 * original (alinha a busca com a coluna de conteúdo); o que muda é o miolo.
 */
import Search from 'virtual:starlight/components/Search';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import config from 'virtual:starlight/user-config';
import BrandMark from './BrandMark.astro';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

/** Base com uma barra só: `BASE_URL` já vem com ou sem, dependendo da config. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <a href={siteTitleHref} class="site-title sl-flex" translate="no">
      <BrandMark id="docs-nav" size={26} />
      <span>Atelier</span>
    </a>
  </div>

  <div class="sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>

  <div class="sl-flex print:hidden right-group">
    <nav class="site-links" aria-label="Seções do site">
      <a href={`${base}/`}>Site</a>
      <a href={`${base}/download`}>Download</a>
    </nav>
    {/* Só os ícones sociais somem no estreito: são os que têm substituto no
        rodapé da página. O `sl-hidden md:sl-flex` é do próprio Starlight. */}
    <div class="sl-hidden md:sl-flex social-icons">
      <SocialIcons />
    </div>
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  /* Marca igual à da landing: texto claro, não azul (o azul é do Starlight). */
  .site-title {
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .site-title span {
    overflow: hidden;
  }

  .site-links {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .site-links a {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-dim);
    text-decoration: none;
  }
  .site-links a:hover {
    color: var(--text);
  }

  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .social-icons::after {
    content: '';
    height: 1.25rem;
    border-inline-end: 1px solid var(--border);
  }

  /* Os links do site ficam em toda largura — a doc não é uma ilha. O que muda
     em tela estreita é o peso: fonte menor, menos respiro, e o separador dos
     ícones sociais sai para não competir com o botão de menu do Starlight. */
  @media (max-width: 72rem) {
    .site-links {
      gap: 14px;
    }
    .site-links a {
      font-size: 12.5px;
    }
    .right-group {
      gap: 0.75rem;
    }
  }

  @media (max-width: 50rem) {
    .site-links {
      gap: 12px;
    }
    .social-icons::after {
      display: none;
    }
    /* O botão de menu do Starlight é `position: fixed` no canto direito; sem
       reservar o espaço dele, os links passariam por baixo. */
    .right-group {
      margin-inline-end: calc(var(--sl-menu-button-size) + 0.5rem);
    }
  }

  /* ---- daqui para baixo é o grid do Header original do Starlight ---- */
  @media (min-width: 50rem) {
    :global(:root[data-has-sidebar]) {
      --__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
    }
    :global(:root:not([data-has-toc])) {
      --__toc-width: 0rem;
    }
    .header {
      --__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
      --__main-column-fr: calc(
        (
            100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
              (2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
              var(--sl-content-width)
          ) / 2
      );
      display: grid;
      grid-template-columns:
        minmax(
          calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
          auto
        )
        1fr
        auto;
      align-content: center;
    }
  }
</style>
