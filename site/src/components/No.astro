---
/**
 * Cartão de nó — mesma anatomia do `.feat-card` da landing: ícone, título,
 * descrição e, quando aplicável, o chip âmbar de "em construção".
 */
interface Props {
  titulo: string;
  pendente?: boolean;
}
const { titulo, pendente = false } = Astro.props;
---

<div class="atelier-no">
  <div class="atelier-no-icon">
    <slot name="icone">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <rect x="3" y="4" width="18" height="16" rx="2"></rect>
        <path d="M3 9h18"></path>
      </svg>
    </slot>
  </div>
  <h3>{titulo}</h3>
  <p><slot /></p>
  {pendente && (
    <span class="atelier-no-pending">
      <span class="dot"></span>proposto por agente = pendente
    </span>
  )}
</div>

<style>
  .atelier-no {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-lg);
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 1rem 0;
  }

  .atelier-no-icon {
    width: 34px;
    height: 34px;
    border-radius: var(--r-md);
    background: var(--surface-2);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
  }

  .atelier-no h3 {
    font-size: 15px;
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .atelier-no p {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-dim);
    margin: 0;
  }

  .atelier-no-pending {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--amber);
    border: 1px solid #4a3a1f;
    background: rgb(217 154 43 / 0.1);
    border-radius: var(--r-pill);
    padding: 3px 8px;
    width: fit-content;
  }

  .atelier-no-pending .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--amber);
  }
</style>
