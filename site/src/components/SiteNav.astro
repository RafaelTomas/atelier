---
/**
 * Barra superior das páginas de marketing.
 *
 * A mesma barra vale para a landing e para o download; o cabeçalho da doc é
 * outro componente (DocsHeader), porque lá ele divide espaço com a busca e o
 * menu do Starlight. Os links de âncora só existem na landing, então a página
 * de download recebe `sections={false}` e fica só com Docs e Download.
 */
import BrandMark from './BrandMark.astro';

interface Props {
  /** Mostra os links de âncora da landing (#problema, #nos, …). */
  sections?: boolean;
  /** Sufixo para o id do gradiente da marca, único por página. */
  markId?: string;
}

const { sections = false, markId = 'nav' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href={`${base}/`}>
      <BrandMark id={markId} size={26} />
      Atelier
    </a>

    <div class="nav-links">
      {sections && (
        <>
          <a class="nav-anchor" href="#problema">O problema</a>
          <a class="nav-anchor" href="#nos">Nós</a>
          <a class="nav-anchor" href="#artesao">O Artesão</a>
        </>
      )}
      <a href={`${base}/docs`}>Docs</a>
      <a href="https://github.com/br3nds0n/atelier">GitHub</a>
    </div>

    <a class="nav-cta" href={`${base}/download`}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
      Baixar
    </a>
  </div>
</div>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--nav-bg-glass);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-soft);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-links a {
    color: var(--text-dim);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  /* Igual ao `.docs-cta` do cabeçalho da doc: mesma sombra no tom do accent
     e o mesmo "afundar" no active, para a marca ter um único botão de
     download em toda a casca do site. */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    flex: none;
    gap: 7px;
    border-radius: var(--r-md);
    font-weight: 600;
    font-size: 13px;
    padding: 8px 15px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2), 0 0 0 1px rgb(0 122 255 / 0.25),
      0 4px 14px rgb(0 122 255 / 0.28);
    transition: background-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .nav-cta svg {
    flex: none;
  }
  .nav-cta:hover {
    background: #1a86ff;
    color: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2), 0 0 0 1px rgb(0 122 255 / 0.35),
      0 6px 18px rgb(0 122 255 / 0.4);
  }
  .nav-cta:active {
    background: #0968d6;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.2), 0 0 0 1px rgb(0 122 255 / 0.35);
    transform: translateY(1px);
  }

  /* A barra existe em toda largura: o que encolhe é o conteúdo, não a barra.
     Primeiro somem as âncoras da própria landing (elas rolam a página e têm
     substituto no corpo dela); Docs e GitHub, que levam para outro lugar,
     ficam até o fim. */
  @media (max-width: 900px) {
    .nav-anchor {
      display: none;
    }
    .nav-links {
      gap: 20px;
    }
  }

  @media (max-width: 520px) {
    .nav-inner {
      gap: 12px;
    }
    .nav-links {
      gap: 14px;
    }
    .nav-links a {
      font-size: 12.5px;
    }
    /* O rótulo da marca sai antes do símbolo: o símbolo já identifica. */
    .brand {
      font-size: 0;
      gap: 0;
    }
  }
</style>
