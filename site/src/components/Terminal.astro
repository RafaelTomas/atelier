---
/**
 * Cartão de terminal — mesma anatomia do `.node-card`/`.node-body` da landing:
 * cabeçalho mono com os três pontos, corpo `#101014` em fonte monoespaçada.
 *
 * O `not-content` no wrapper não é decorativo: sem ele o Starlight aplica o
 * espaçamento de prosa (`* + *`) aos elementos internos do cartão e abre uma
 * faixa entre o cabeçalho e o corpo. A classe manda o tema ignorar a subárvore,
 * que já tem estilo próprio aqui embaixo.
 */
interface Props {
  title?: string;
}
const { title = 'Terminal' } = Astro.props;
---

<div class="atelier-terminal not-content">
  <div class="atelier-terminal-head">
    <span class="dot" style="background:#e74c3c"></span>
    <span class="dot" style="background:#d99a2b"></span>
    <span class="dot" style="background:#2ecc71"></span>
    <span class="title">{title}</span>
  </div>
  <div class="atelier-terminal-body">
    <slot />
  </div>
</div>

<style>
  .atelier-terminal {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    margin: 1.5rem 0;
  }

  .atelier-terminal-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border-soft);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-dim);
  }

  .atelier-terminal-head .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .atelier-terminal-head .title {
    margin-left: 4px;
  }

  .atelier-terminal-body {
    padding: 12px 14px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.8;
    color: #dcdce2;
    background: #101014;
  }

  .atelier-terminal-body :global(.prompt) {
    color: var(--green);
  }
  .atelier-terminal-body :global(.dim) {
    color: var(--text-faint);
  }
</style>
