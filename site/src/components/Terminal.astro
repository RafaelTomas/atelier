---
/**
 * Cartão de terminal — mesma anatomia do `.node-card`/`.node-body` da landing:
 * cabeçalho mono com os três pontos, corpo `#101014` em fonte monoespaçada.
 *
 * O `not-content` no wrapper não é decorativo: sem ele o Starlight aplica o
 * espaçamento de prosa (`* + *`) aos elementos internos do cartão e abre uma
 * faixa entre o cabeçalho e o corpo. A classe manda o tema ignorar a subárvore,
 * que já tem estilo próprio aqui embaixo.
 */
interface Props {
  title?: string;
}
const { title = 'Terminal' } = Astro.props;
---

<div class="atelier-terminal not-content">
  <div class="atelier-terminal-head">
    <span class="dot" style="background:#e74c3c"></span>
    <span class="dot" style="background:#d99a2b"></span>
    <span class="dot" style="background:#2ecc71"></span>
    <span class="title">{title}</span>
    <button type="button" class="copy-btn" data-copy-btn aria-label="Copiar comando">
      <svg class="icon-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <svg class="icon-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" hidden>
        <path d="M20 6 9 17l-5-5"></path>
      </svg>
    </button>
  </div>
  <div class="atelier-terminal-body">
    <slot />
  </div>
</div>

<script>
  /**
   * Copia só as linhas de comando (.prompt), sem os comentários (.dim) — um
   * cartão de Terminal mistura narrativa com comando, e colar a explicação
   * junto quebraria o comando quando executado. Cada botão sobe seu próprio
   * listener (o componente pode aparecer várias vezes numa mesma página).
   */
  document.querySelectorAll<HTMLButtonElement>('.atelier-terminal [data-copy-btn]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const body = btn.closest('.atelier-terminal')?.querySelector('.atelier-terminal-body');
      if (!body) return;

      const clone = body.cloneNode(true) as HTMLElement;
      clone.querySelectorAll('.dim').forEach((el) => el.remove());
      const text = (clone.textContent ?? '')
        .split('\n')
        .map((line) => line.trim())
        .filter(Boolean)
        .join('\n');

      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }

      const copyIcon = btn.querySelector('.icon-copy');
      const checkIcon = btn.querySelector('.icon-check');
      copyIcon?.setAttribute('hidden', '');
      checkIcon?.removeAttribute('hidden');
      btn.classList.add('is-copied');
      setTimeout(() => {
        copyIcon?.removeAttribute('hidden');
        checkIcon?.setAttribute('hidden', '');
        btn.classList.remove('is-copied');
      }, 1500);
    });
  });
</script>

<style>
  .atelier-terminal {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    margin: 1.5rem 0;
  }

  .atelier-terminal-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border-soft);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-dim);
  }

  .atelier-terminal-head .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .atelier-terminal-head .title {
    margin-left: 4px;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
  }
  .copy-btn:hover {
    background: var(--surface-3);
    color: var(--text);
  }
  .copy-btn.is-copied {
    color: var(--green);
  }

  .atelier-terminal-body {
    padding: 12px 14px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.8;
    color: #dcdce2;
    background: #101014;
  }

  .atelier-terminal-body :global(.prompt) {
    color: var(--green);
  }
  .atelier-terminal-body :global(.dim) {
    color: var(--text-faint);
  }
</style>
