---
/**
 * Alternador de tema — Sistema / Claro / Escuro.
 *
 * Três botões (não um único toggle de 2 estados) porque "sistema" é um modo
 * de verdade, não só um valor intermediário: é a ausência de `data-theme`,
 * que deixa o `@media (prefers-color-scheme)` do atelier.css decidir.
 * Persistência em localStorage sob a chave `atelier-theme` — o mesmo nome que
 * o script anti-FOUC (Marketing.astro / astro.config.mjs) lê antes do
 * primeiro paint.
 */
---

<div class="theme-toggle" role="group" aria-label="Tema">
  <button type="button" class="theme-btn" data-theme-choice="system" aria-label="Seguir sistema">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="4" width="18" height="13" rx="2" stroke="currentColor" stroke-width="2"></rect>
      <path d="M8 21h8M12 17v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
  </button>
  <button type="button" class="theme-btn" data-theme-choice="light" aria-label="Tema claro">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="2"></circle>
      <path
        d="M12 2.5v2M12 19.5v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2.5 12h2M19.5 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
    </svg>
  </button>
  <button type="button" class="theme-btn" data-theme-choice="dark" aria-label="Tema escuro">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"
        stroke="currentColor"
        stroke-width="2"
        stroke-linejoin="round"
      ></path>
    </svg>
  </button>
</div>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    flex: none;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface-2);
  }

  .theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border: none;
    border-radius: calc(var(--r-md) - 2px);
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
  }
  .theme-btn:hover {
    color: var(--text-dim);
  }
  .theme-btn[aria-pressed='true'] {
    background: var(--surface-3);
    color: var(--accent);
  }
</style>

<script>
  // Módulo normal do Astro (não is:inline): só sincroniza o estado visual e
  // reage a clique — o tema em si já foi aplicado pelo script anti-FOUC no
  // <head>, antes deste componente sequer montar.
  const STORAGE_KEY = 'atelier-theme';

  function currentChoice(): 'system' | 'light' | 'dark' {
    const stored = localStorage.getItem(STORAGE_KEY);
    return stored === 'light' || stored === 'dark' ? stored : 'system';
  }

  function applyChoice(choice: 'system' | 'light' | 'dark') {
    if (choice === 'system') {
      localStorage.removeItem(STORAGE_KEY);
      document.documentElement.removeAttribute('data-theme');
    } else {
      localStorage.setItem(STORAGE_KEY, choice);
      document.documentElement.setAttribute('data-theme', choice);
    }
  }

  function syncButtons(root: ParentNode) {
    const active = currentChoice();
    root.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.themeChoice === active));
    });
  }

  document.querySelectorAll('.theme-toggle').forEach((toggle) => {
    syncButtons(toggle);
    toggle.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const choice = btn.dataset.themeChoice as 'system' | 'light' | 'dark';
        applyChoice(choice);
        document.querySelectorAll('.theme-toggle').forEach(syncButtons);
      });
    });
  });
</script>
