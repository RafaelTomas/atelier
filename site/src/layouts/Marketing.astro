---
import '../styles/atelier.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Atelier: seu ateliê de agentes de IA',
  description = 'Um canvas infinito onde Claude, Codex e qualquer CLI de agente trabalham lado a lado.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* is:inline + primeira coisa no <head>: precisa rodar antes do primeiro
        paint, senão a página pisca no tema errado por um frame. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('atelier-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    color: #3d94ff;
  }

  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }
</style>
