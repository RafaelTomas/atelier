---
import '../styles/atelier.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Atelier — Seu ateliê de agentes de IA',
  description = 'Um canvas infinito onde Claude, Codex e qualquer CLI de agente trabalham lado a lado.',
} = Astro.props;

/** Base com uma barra só — `BASE_URL` varia com a config de deploy. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- O Starlight injeta o favicon nas páginas da doc; estas aqui são páginas
         Astro puras e ficavam sem nenhum. O `.ico` é o fallback de quem não lê
         SVG, e vem depois: o navegador fica com a última declaração que entende. -->
    <link rel="icon" href={`${base}/favicon.png`} type="image/png" sizes="192x192" />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48 32x32 16x16" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    color: #3d94ff;
  }

  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }
</style>
