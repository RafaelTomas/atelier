---
import Marketing from '../layouts/Marketing.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const REPO = 'br3nds0n/atelier';
const RELEASES_LATEST_URL = `https://github.com/${REPO}/releases/latest`;

interface Asset {
  name: string;
  size: number;
  browser_download_url: string;
}

interface ReleaseData {
  version: string;
  htmlUrl: string;
  assets: Asset[];
  checksums: Record<string, string>;
}

// Resolução em tempo de build: o HTML sai com versão, links e tamanhos já
// embutidos — zero JS no caminho principal, zero dependência da API no
// runtime. Se o fetch falhar (repo privado, sem release publicada, API fora,
// build sem rede), a página cai para um estado degradado em vez de quebrar.
let release: ReleaseData | null = null;

try {
  const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, {
    headers: {
      Accept: 'application/vnd.github+json',
      'User-Agent': 'atelier-site-build',
    },
  });

  if (res.ok) {
    const data = await res.json();
    const assets: Asset[] = (data.assets ?? []).map((a: { name: string; size: number; browser_download_url: string }) => ({
      name: a.name,
      size: a.size,
      browser_download_url: a.browser_download_url,
    }));

    // O release.yml gera um checksums.txt (saída de `sha256sum *`) e publica
    // junto dos binários. Usamos os hashes de lá — nunca inventamos um.
    const checksums: Record<string, string> = {};
    const checksumsAsset = assets.find((a) => a.name === 'checksums.txt');
    if (checksumsAsset) {
      try {
        const txt = await fetch(checksumsAsset.browser_download_url).then((r) => r.text());
        for (const line of txt.split('\n')) {
          const match = line.trim().match(/^([a-f0-9]{64})\s+\*?(.+)$/i);
          if (match) checksums[match[2]] = match[1];
        }
      } catch {
        // segue sem hashes
      }
    }

    release = {
      version: data.tag_name ?? data.name ?? '',
      htmlUrl: data.html_url ?? RELEASES_LATEST_URL,
      assets,
      checksums,
    };
  }
} catch {
  release = null;
}

function formatSize(bytes: number): string {
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function findAsset(assets: Asset[], test: (nameLower: string) => boolean): Asset | undefined {
  return assets.find((a) => test(a.name.toLowerCase()));
}

interface SecondaryLink {
  label: string;
  asset: Asset;
}

interface Platform {
  primary?: Asset;
  secondaries: SecondaryLink[];
  hash?: string;
}

function buildPlatform(
  assets: Asset[],
  checksums: Record<string, string>,
  primaryTest: (n: string) => boolean,
  secondaryTests: { label: string; test: (n: string) => boolean }[],
): Platform {
  const primary = findAsset(assets, primaryTest);
  const secondaries = secondaryTests
    .map(({ label, test }) => {
      const asset = findAsset(assets, test);
      return asset ? { label, asset } : null;
    })
    .filter((s): s is SecondaryLink => s !== null);
  return { primary, secondaries, hash: primary ? checksums[primary.name] : undefined };
}

const mac: Platform | null = release
  ? buildPlatform(
      release.assets,
      release.checksums,
      (n) => n.endsWith('.dmg'),
      [{ label: '.zip', test: (n) => n.endsWith('.zip') && n.includes('mac') }],
    )
  : null;

const win: Platform | null = release
  ? buildPlatform(
      release.assets,
      release.checksums,
      (n) => n.endsWith('.exe'),
      [{ label: '.zip', test: (n) => n.endsWith('.zip') && n.includes('win') }],
    )
  : null;

const linux: Platform | null = release
  ? buildPlatform(
      release.assets,
      release.checksums,
      (n) => n.endsWith('.appimage'),
      [
        { label: '.deb', test: (n) => n.endsWith('.deb') },
        { label: '.zip', test: (n) => n.endsWith('.zip') && n.includes('linux') },
      ],
    )
  : null;

const releaseNotesUrl = release?.htmlUrl ?? RELEASES_LATEST_URL;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const installGuideUrl = `${base}/docs/primeiros-passos/instalacao`;
---

<Marketing title="Download: Atelier" description="Baixe o Atelier para macOS, Windows ou Linux.">
  <SiteNav markId="dl-nav" />

  <!-- ============ HERO ============ -->
  <header class="dl-hero grid-bg">
    <div class="wrap">
      <p class="kicker">Download</p>
      <h1>Baixe o <span class="grad">Atelier</span>.</h1>

      {release ? (
        <>
          <p class="lede">macOS, Windows e Linux, sempre os três na mesma release. Nada de conta, nada de telemetria: o app roda inteiro na sua máquina.</p>
          <span class="eyebrow"><span class="dot"></span>VERSÃO {release.version}</span>
        </>
      ) : (
        <>
          <p class="lede">Os instaladores aparecem aqui automaticamente assim que a primeira release for publicada. Até lá, dois comandos rodam o Atelier a partir do código-fonte.</p>
          <div class="cta-row">
            <a class="btn btn-primary btn-lg" href="#codigo-fonte">Rodar do código-fonte</a>
            <a class="btn btn-ghost btn-lg" href={RELEASES_LATEST_URL}>Acompanhar as releases</a>
          </div>
        </>
      )}
    </div>
  </header>

  <!-- ============ OS TRÊS SISTEMAS ============ -->
  <section class="dl-platforms">
    <div class="wrap">
      <div class="dl-grid">
        <!-- ============ macOS ============ -->
        <div class="dl-card" data-os="mac">
          <div class="dl-card-head">
            <span class="dl-os-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M9 21v-4h6v4"></path></svg>
            </span>
            <h2>macOS</h2>
            <span class="dl-detected-badge">Seu sistema</span>
          </div>

          {mac?.primary ? (
            <>
              <a class="btn btn-primary btn-lg dl-primary" href={mac.primary.browser_download_url}>
                Baixar .dmg <span class="dl-size">{formatSize(mac.primary.size)}</span>
              </a>
              {mac.secondaries.length > 0 && (
                <ul class="dl-secondary">
                  {mac.secondaries.map((s) => (
                    <li><a href={s.asset.browser_download_url}>{s.label} <span class="dl-size">{formatSize(s.asset.size)}</span></a></li>
                  ))}
                </ul>
              )}
              {mac.hash && <p class="dl-hash">SHA-256 <code>{mac.hash}</code></p>}
            </>
          ) : (
            <>
              <span class="dl-soon">Instalador ainda não publicado</span>
              <a class="btn btn-ghost btn-lg dl-primary" href="#codigo-fonte">Rodar do código-fonte</a>
            </>
          )}

          <div class="dl-warning">
            <p class="dl-warning-title">O app não é assinado com um Developer ID da Apple.</p>
            <p>No macOS 15 e mais recentes o sistema recusa abrir de primeira. Para liberar: <b>Ajustes do Sistema → Privacidade e Segurança → Abrir Mesmo Assim</b>, depois de uma primeira tentativa. Só precisa fazer isso uma vez.</p>
          </div>
        </div>

        <!-- ============ Windows ============ -->
        <div class="dl-card" data-os="win">
          <div class="dl-card-head">
            <span class="dl-os-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 6l8-1v7H3zM13 4.6L21 3.5V12h-8zM3 13h8v6l-8-1zM13 13h8v8.5L13 20.4z"></path></svg>
            </span>
            <h2>Windows</h2>
            <span class="dl-detected-badge">Seu sistema</span>
          </div>

          {win?.primary ? (
            <>
              <a class="btn btn-primary btn-lg dl-primary" href={win.primary.browser_download_url}>
                Baixar .exe <span class="dl-size">{formatSize(win.primary.size)}</span>
              </a>
              {win.secondaries.length > 0 && (
                <ul class="dl-secondary">
                  {win.secondaries.map((s) => (
                    <li><a href={s.asset.browser_download_url}>{s.label} <span class="dl-size">{formatSize(s.asset.size)}</span></a></li>
                  ))}
                </ul>
              )}
              {win.hash && <p class="dl-hash">SHA-256 <code>{win.hash}</code></p>}
            </>
          ) : (
            <>
              <span class="dl-soon">Instalador ainda não publicado</span>
              <a class="btn btn-ghost btn-lg dl-primary" href="#codigo-fonte">Rodar do código-fonte</a>
            </>
          )}

          <div class="dl-warning">
            <p class="dl-warning-title">O instalador não tem certificado de assinatura (OV/EV).</p>
            <p>O SmartScreen vai bloquear com "O Windows protegeu o computador". Para continuar: <b>Mais informações → Executar assim mesmo</b>. A reputação do binário só se constrói com o tempo, isso é esperado num app novo, não um sinal de malware.</p>
          </div>
        </div>

        <!-- ============ Linux ============ -->
        <div class="dl-card" data-os="linux">
          <div class="dl-card-head">
            <span class="dl-os-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 18l-5-6 5-6M15 6l5 6-5 6"></path></svg>
            </span>
            <h2>Linux</h2>
            <span class="dl-detected-badge">Seu sistema</span>
          </div>

          {linux?.primary ? (
            <>
              <a class="btn btn-primary btn-lg dl-primary" href={linux.primary.browser_download_url}>
                Baixar .AppImage <span class="dl-size">{formatSize(linux.primary.size)}</span>
              </a>
              {linux.secondaries.length > 0 && (
                <ul class="dl-secondary">
                  {linux.secondaries.map((s) => (
                    <li><a href={s.asset.browser_download_url}>{s.label} <span class="dl-size">{formatSize(s.asset.size)}</span></a></li>
                  ))}
                </ul>
              )}
              {linux.hash && <p class="dl-hash">SHA-256 <code>{linux.hash}</code></p>}
            </>
          ) : (
            <>
              <span class="dl-soon">Instalador ainda não publicado</span>
              <a class="btn btn-ghost btn-lg dl-primary" href="#codigo-fonte">Rodar do código-fonte</a>
            </>
          )}

          <div class="dl-warning">
            <p class="dl-warning-title">O AppImage não vem com permissão de execução.</p>
            <p>Depois de baixar: <b>botão direito → Propriedades → Permissões → Permitir execução</b>, ou <code>chmod +x *.AppImage</code> no terminal. O <code>.deb</code> já resolve isso na instalação.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CÓDIGO-FONTE ============ -->
  <section id="codigo-fonte" class="dl-source">
    <div class="wrap dl-source-grid">
      <div>
        <p class="kicker">Código-fonte</p>
        <h2>{release ? 'Ou rode direto do repositório' : 'Rode direto do repositório'}</h2>
        <p class="section-lede">Do canvas vazio até dois agentes conversando entre si, em dois comandos. É o mesmo app: o instalador só empacota isto.</p>
        <ul class="req-list">
          <li><b>Node 22+</b>: e no macOS, as Command Line Tools.</li>
          <li><b>npm run dev</b>: isola os dados em <code>~/.atelier-dev</code>; não encosta no seu workspace real.</li>
          <li><a href={installGuideUrl}>Guia de instalação completo →</a></li>
        </ul>
      </div>
      <div class="code-window">
        <div class="code-window-head">
          <span style="background:#e74c3c"></span><span style="background:#d99a2b"></span><span style="background:#2ecc71"></span>
        </div>
        <pre><span class="rem"># clone e instale</span>
git clone https://github.com/br3nds0n/atelier.git
cd atelier
npm install

<span class="rem"># rode</span>
npm run dev</pre>
      </div>
    </div>
  </section>

  <!-- ============ REQUISITOS E LINKS ============ -->
  <section class="dl-more">
    <div class="wrap dl-more-grid">
      <div>
        <p class="kicker">Requisitos mínimos</p>
        <ul class="req-list">
          <li><b>macOS</b>: 12 (Monterey) ou mais recente, Apple Silicon ou Intel.</li>
          <li><b>Windows</b>: Windows 10 64-bit ou mais recente.</li>
          <li><b>Linux</b>: distribuição x64 com glibc 2.31+ (Ubuntu 20.04 ou equivalente).</li>
        </ul>
      </div>
      <div>
        <p class="kicker">Mais</p>
        <ul class="req-list">
          <li><a href={releaseNotesUrl}>Notas da versão →</a></li>
          <li><a href={`${base}/docs`}>Documentação →</a></li>
          <li><a href={`${base}/docs/primeiros-passos/primeiro-canvas`}>Seu primeiro canvas →</a></li>
        </ul>
      </div>
    </div>
  </section>

  <SiteFooter markId="dl-footer" />
</Marketing>

<script>
  // Detecção de SO só para destacar o cartão provável — os três continuam
  // sempre visíveis e clicáveis. Ninguém é redirecionado nem escondido.
  const ua = navigator.userAgent;
  let os: 'mac' | 'win' | 'linux' | null = null;
  if (/Mac OS X/.test(ua) && !/iPhone|iPad/.test(ua)) os = 'mac';
  else if (/Windows NT/.test(ua)) os = 'win';
  else if (/Linux/.test(ua) && !/Android/.test(ua)) os = 'linux';

  if (os) {
    const card = document.querySelector(`.dl-card[data-os="${os}"]`);
    card?.classList.add('dl-card-detected');
  }
</script>

<style>
  /* Botão, kicker, escala de título, `.code-window` e `.req-list` vêm de
     site.css — o mesmo vocabulário da landing. Aqui só o que é desta página. */

  .dl-hero {
    padding: 72px 0 56px;
  }
  .dl-hero .lede {
    max-width: 56ch;
    margin-bottom: 24px;
  }

  .dl-platforms {
    padding-top: 8px;
  }

  /* Sem `align-items: start`: os cartões esticam para a mesma altura, e é isso
     que faz o aviso do rodapé (com `margin-top: auto`) alinhar nas três colunas
     mesmo quando um texto é mais longo que o outro. */
  .dl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .dl-card {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-xl);
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
  }

  .dl-card-detected {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 16px 40px rgb(0 0 0 / 0.35);
  }

  .dl-card-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dl-os-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--r-md);
    background: var(--surface-2);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex: none;
  }

  .dl-card-head h2 {
    font-size: 16px;
    margin: 0;
    font-weight: 650;
    letter-spacing: -0.005em;
    flex: 1;
  }

  .dl-detected-badge {
    display: none;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--r-pill);
    padding: 2px 8px;
  }
  .dl-card-detected .dl-detected-badge {
    display: inline-block;
  }

  /* O botão ocupa a largura do cartão; o texto fica centrado. */
  .dl-primary {
    width: 100%;
    justify-content: center;
  }

  .dl-soon {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .dl-size {
    font-family: var(--mono);
    font-size: 11px;
    opacity: 0.75;
  }

  .dl-secondary {
    list-style: none;
    margin: -6px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .dl-secondary li a {
    font-size: 12.5px;
    color: var(--text-dim);
  }
  .dl-secondary li a:hover {
    color: var(--text);
  }

  .dl-hash {
    margin: -4px 0 0;
    font-size: 11px;
    color: var(--text-faint);
    word-break: break-all;
  }
  .dl-hash code {
    font-family: var(--mono);
    color: var(--text-dim);
  }

  /* Empurrado para a base do cartão: as três colunas terminam alinhadas mesmo
     com avisos de tamanhos diferentes. */
  .dl-warning {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border-soft);
  }
  .dl-warning-title {
    margin: 0 0 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--amber);
  }
  .dl-warning p {
    margin: 0 0 6px;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text-dim);
  }
  .dl-warning p:last-child {
    margin-bottom: 0;
  }
  .dl-warning b {
    color: var(--text);
  }
  .dl-warning code {
    font-family: var(--mono);
    color: var(--text);
    font-size: 11.5px;
  }

  /* ---------- código-fonte ---------- */

  .dl-source {
    background: var(--surface);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    padding: 72px 0;
  }
  .dl-source-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 48px;
    align-items: center;
  }
  .dl-source .req-list {
    margin-top: 20px;
  }
  .dl-source code {
    font-family: var(--mono);
    color: var(--text);
  }

  /* ---------- requisitos e links ---------- */

  .dl-more {
    padding: 64px 0 88px;
  }
  .dl-more-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }
  .dl-more .req-list {
    margin-top: 0;
  }
  .dl-more .req-list a {
    color: var(--text-dim);
  }
  .dl-more .req-list a:hover {
    color: var(--text);
  }

  @media (max-width: 980px) {
    .dl-grid {
      grid-template-columns: 1fr;
    }
    .dl-source-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 640px) {
    .dl-more-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
