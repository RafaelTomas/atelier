---
import Marketing from '../layouts/Marketing.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const GITLAB = 'https://gitlab.fcxlabs.com';
const PROJECT = 'platform/tools/fcx-atelier-ai-agents-orquestrator';
const REPO_URL = `${GITLAB}/${PROJECT}`;
const RELEASES_LATEST_URL = `${REPO_URL}/-/releases/permalink/latest`;

interface Asset {
  name: string;
  /** Opcional: a API do GitLab não devolve tamanho — ver `probeSize`. */
  size?: number;
  url: string;
}

interface ReleaseData {
  version: string;
  htmlUrl: string;
  assets: Asset[];
  checksums: Record<string, string>;
}

// Resolução em tempo de build: o HTML sai com versão, links e tamanhos já
// embutidos — zero JS no caminho principal, zero dependência da API no
// runtime. Se o fetch falhar (repo privado, sem release publicada, API fora,
// build sem rede), a página cai para um estado degradado em vez de quebrar.
let release: ReleaseData | null = null;

// O projeto é privado: sem token a API responde 404 (o GitLab não distingue
// "não existe" de "você não pode ver"), e a página inteira cai no estado
// degradado. Dentro do CI o `CI_JOB_TOKEN` existe e resolve; fora dele —
// `npm run dev`, ou o build no GitHub Actions, que nem alcança o host interno —
// a ausência é esperada e o estado degradado é a resposta certa.
//
// O token só vive aqui, no frontmatter, que roda em tempo de build. Nada dele
// entra no HTML.
const jobToken = process.env.CI_JOB_TOKEN;

try {
  // `permalink/latest` resolve a release mais recente sem precisar saber a tag.
  const res = await fetch(
    `${GITLAB}/api/v4/projects/${encodeURIComponent(PROJECT)}/releases/permalink/latest`,
    { headers: { 'User-Agent': 'atelier-site-build', ...(jobToken ? { 'JOB-TOKEN': jobToken } : {}) } },
  );

  if (res.ok) {
    const data = await res.json();

    // `assets.links` são os binários anexados à release. O irmão
    // `assets.sources` é o tarball do código-fonte que o GitLab gera sozinho:
    // não é instalador e ficaria fingindo ser um.
    const links: { name: string; url: string; direct_asset_url?: string }[] = data.assets?.links ?? [];
    const assets: Asset[] = await Promise.all(
      links.map(async (l) => {
        const url = l.direct_asset_url ?? l.url;
        return { name: l.name, url, size: await probeSize(url) };
      }),
    );

    // O release.yml gera um checksums.txt (saída de `sha256sum *`) e publica
    // junto dos binários. Usamos os hashes de lá — nunca inventamos um.
    const checksums: Record<string, string> = {};
    const checksumsAsset = assets.find((a) => a.name === 'checksums.txt');
    if (checksumsAsset) {
      try {
        const txt = await fetch(checksumsAsset.url, {
          headers: jobToken ? { 'JOB-TOKEN': jobToken } : {},
        }).then((r) => r.text());
        for (const line of txt.split('\n')) {
          const match = line.trim().match(/^([a-f0-9]{64})\s+\*?(.+)$/i);
          if (match) checksums[match[2]] = match[1];
        }
      } catch {
        // segue sem hashes
      }
    }

    release = {
      version: data.tag_name ?? data.name ?? '',
      htmlUrl: data._links?.self ?? RELEASES_LATEST_URL,
      assets,
      checksums,
    };
  }
} catch {
  release = null;
}

/**
 * A API de releases do GitLab devolve nome e URL do asset, e nenhum tamanho —
 * ao contrário da do GitHub, que trazia `size`. O número na página vem daqui,
 * de um HEAD em tempo de build.
 *
 * Falhou, redirecionou para quem não declara `Content-Length`, ou o asset está
 * atrás de autenticação? O rótulo simplesmente não aparece. Um tamanho
 * inventado seria pior que tamanho nenhum numa página de download.
 */
async function probeSize(url: string): Promise<number | undefined> {
  try {
    const res = await fetch(url, {
      method: 'HEAD',
      redirect: 'follow',
      headers: jobToken ? { 'JOB-TOKEN': jobToken } : {},
    });
    const len = res.headers.get('content-length');
    return len ? Number(len) : undefined;
  } catch {
    return undefined;
  }
}

function formatSize(bytes: number): string {
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function findAsset(assets: Asset[], test: (nameLower: string) => boolean): Asset | undefined {
  return assets.find((a) => test(a.name.toLowerCase()));
}

interface Platform {
  zip?: Asset;
  hash?: string;
}

/**
 * Um zip por sistema — é o único formato que a release publica.
 *
 * O casamento é pelo nome do sistema dentro do arquivo
 * (`atelier-0.1.0-linux-x64.zip`), e não pela extensão: os três terminam em
 * `.zip`. Quem garante esse nome é o `artifactName` de cada alvo em
 * electron-builder.yml.
 */
function buildPlatform(
  assets: Asset[],
  checksums: Record<string, string>,
  os: string,
): Platform {
  const zip = findAsset(assets, (n) => n.endsWith('.zip') && n.includes(os));
  return { zip, hash: zip ? checksums[zip.name] : undefined };
}

const mac: Platform | null = release ? buildPlatform(release.assets, release.checksums, 'mac') : null;
const win: Platform | null = release ? buildPlatform(release.assets, release.checksums, 'win') : null;
const linux: Platform | null = release
  ? buildPlatform(release.assets, release.checksums, 'linux')
  : null;

const releaseNotesUrl = release?.htmlUrl ?? RELEASES_LATEST_URL;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const installGuideUrl = `${base}/docs/primeiros-passos/instalacao`;
---

<Marketing title="Download — Atelier" description="Baixe o Atelier para macOS, Windows ou Linux.">
  <SiteNav markId="dl-nav" />

  <!-- ============ HERO ============ -->
  <header class="dl-hero grid-bg">
    <div class="wrap">
      <p class="kicker">Download</p>
      <h1>Baixe o <span class="grad">Atelier</span>.</h1>

      {release ? (
        <>
          <p class="lede">macOS, Windows e Linux, sempre os três na mesma release. Um zip por sistema, sem instalador: descompacte e abra. Nada de conta, nada de telemetria — o app roda inteiro na sua máquina.</p>
          <span class="eyebrow"><span class="dot"></span>VERSÃO {release.version}</span>
        </>
      ) : (
        <>
          <p class="lede">Os downloads aparecem aqui automaticamente assim que a primeira release for publicada.</p>
          <div class="cta-row">
            <a class="btn btn-primary btn-lg" href={RELEASES_LATEST_URL}>Acompanhar as releases</a>
            <a class="btn btn-ghost btn-lg" href={installGuideUrl}>Guia de instalação</a>
          </div>
        </>
      )}
    </div>
  </header>

  <!-- ============ OS TRÊS SISTEMAS ============ -->
  <section class="dl-platforms">
    <div class="wrap">
      <div class="dl-grid">
        <!-- ============ macOS ============ -->
        <div class="dl-card" data-os="mac">
          <div class="dl-card-head">
            <span class="dl-os-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M9 21v-4h6v4"></path></svg>
            </span>
            <h2>macOS</h2>
            <span class="dl-detected-badge">Seu sistema</span>
          </div>

          {mac?.zip ? (
            <>
              <a class="btn btn-primary btn-lg dl-primary" href={mac.zip.url}>
                Baixar .zip {mac.zip.size && <span class="dl-size">{formatSize(mac.zip.size)}</span>}
              </a>
              {mac.hash && <p class="dl-hash">SHA-256 <code>{mac.hash}</code></p>}
            </>
          ) : (
            <>
              <span class="dl-soon">Ainda não publicado</span>
              <a class="btn btn-ghost btn-lg dl-primary" href={RELEASES_LATEST_URL}>Ver as releases</a>
            </>
          )}

          <div class="dl-warning">
            <p class="dl-warning-title">O app não é assinado com um Developer ID da Apple.</p>
            <p>O sistema recusa abrir de primeira. O passo a passo para liberar está <a href="#instalar">logo abaixo</a> — só precisa ser feito uma vez.</p>
          </div>
        </div>

        <!-- ============ Windows ============ -->
        <div class="dl-card" data-os="win">
          <div class="dl-card-head">
            <span class="dl-os-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 6l8-1v7H3zM13 4.6L21 3.5V12h-8zM3 13h8v6l-8-1zM13 13h8v8.5L13 20.4z"></path></svg>
            </span>
            <h2>Windows</h2>
            <span class="dl-detected-badge">Seu sistema</span>
          </div>

          {win?.zip ? (
            <>
              <a class="btn btn-primary btn-lg dl-primary" href={win.zip.url}>
                Baixar .zip {win.zip.size && <span class="dl-size">{formatSize(win.zip.size)}</span>}
              </a>
              {win.hash && <p class="dl-hash">SHA-256 <code>{win.hash}</code></p>}
            </>
          ) : (
            <>
              <span class="dl-soon">Ainda não publicado</span>
              <a class="btn btn-ghost btn-lg dl-primary" href={RELEASES_LATEST_URL}>Ver as releases</a>
            </>
          )}

          <div class="dl-warning">
            <p class="dl-warning-title">O executável não tem certificado de assinatura (OV/EV).</p>
            <p>O SmartScreen vai bloquear com "O Windows protegeu o computador" — <a href="#instalar">como passar disso</a>. A reputação de um binário só se constrói com o tempo; num app novo isso é esperado, não sinal de malware.</p>
          </div>
        </div>

        <!-- ============ Linux ============ -->
        <div class="dl-card" data-os="linux">
          <div class="dl-card-head">
            <span class="dl-os-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 18l-5-6 5-6M15 6l5 6-5 6"></path></svg>
            </span>
            <h2>Linux</h2>
            <span class="dl-detected-badge">Seu sistema</span>
          </div>

          {linux?.zip ? (
            <>
              <a class="btn btn-primary btn-lg dl-primary" href={linux.zip.url}>
                Baixar .zip {linux.zip.size && <span class="dl-size">{formatSize(linux.zip.size)}</span>}
              </a>
              {linux.hash && <p class="dl-hash">SHA-256 <code>{linux.hash}</code></p>}
            </>
          ) : (
            <>
              <span class="dl-soon">Ainda não publicado</span>
              <a class="btn btn-ghost btn-lg dl-primary" href={RELEASES_LATEST_URL}>Ver as releases</a>
            </>
          )}

          <div class="dl-warning">
            <p class="dl-warning-title">O zip descompacta na pasta atual, sem criar uma própria.</p>
            <p>São ~30 arquivos soltos se você extrair no lugar errado. <a href="#instalar">As instruções abaixo</a> usam uma pasta dedicada, e cobrem o erro de sandbox que aparece em algumas distribuições.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COMO INSTALAR ============ -->
  <section id="instalar" class="dl-install">
    <div class="wrap">
      <p class="kicker">Como instalar</p>
      <h2>Do zip até o app aberto, pelo terminal</h2>
      <p class="section-lede">Não há instalador em nenhum dos três sistemas — o zip já traz o app pronto. As sequências abaixo não baixam nada: elas assumem o zip já na sua pasta de downloads, colocam o app onde aquele sistema espera encontrá-lo, e abrem. O passo do meio, em cada uma, é o que desarma o aviso de segurança que todo binário sem assinatura recebe.</p>

      <div class="dl-install-grid">
        <!-- ============ macOS ============ -->
        <article class="dl-steps">
          <h3>macOS</h3>
          <pre>cd ~/Downloads
unzip -q atelier-*-mac-*.zip -d /Applications

<span class="rem"># tira a quarentena do download</span>
xattr -dr com.apple.quarantine /Applications/Atelier.app

open -a Atelier</pre>
          <p class="dl-steps-note">Sem o <code>xattr</code>, o Gatekeeper recusa abrir — às vezes dizendo que o app "está danificado", o que não é verdade: é a marca de arquivo baixado, não corrupção. Removê-la é o equivalente em terminal ao <b>botão direito → Abrir</b>.</p>
          <p class="dl-steps-note">Atualizar é repetir os mesmos comandos. Seus dados ficam em <code>~/.atelier</code> e não são tocados.</p>
        </article>

        <!-- ============ Windows ============ -->
        <article class="dl-steps">
          <h3>Windows <span class="dl-shell">PowerShell</span></h3>
          <pre>cd $env:USERPROFILE\Downloads

<span class="rem"># remove a marca de "baixado da internet"</span>
Unblock-File .\atelier-*-win-*.zip

Expand-Archive .\atelier-*-win-*.zip `
  -DestinationPath $env:LOCALAPPDATA\Atelier -Force

& $env:LOCALAPPDATA\Atelier\Atelier.exe</pre>
          <p class="dl-steps-note">O <code>Unblock-File</code> vai no <b>zip</b>, antes de extrair: feito depois, cada arquivo extraído já herdou o bloqueio e o SmartScreen aparece assim mesmo.</p>
          <p class="dl-steps-note">Sem instalador não existe atalho. Para criar um no menu Iniciar:</p>
          <pre>$link = (New-Object -ComObject WScript.Shell).CreateShortcut(
  "$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Atelier.lnk")
$link.TargetPath = "$env:LOCALAPPDATA\Atelier\Atelier.exe"
$link.Save()</pre>
        </article>

        <!-- ============ Linux ============ -->
        <article class="dl-steps">
          <h3>Linux</h3>
          <pre>cd ~/Downloads
unzip -q atelier-*-linux-x64.zip -d ~/.local/share/atelier

~/.local/share/atelier/atelier</pre>
          <p class="dl-steps-note">A pasta de destino não é opcional: o zip guarda os arquivos na raiz, então extrair sem <code>-d</code> espalha 17 itens onde você estiver.</p>
          <p class="dl-steps-note">Para o app aparecer no menu de aplicativos:</p>
          <pre>mkdir -p ~/.local/share/applications
cat &gt; ~/.local/share/applications/atelier.desktop &lt;&lt;EOF
[Desktop Entry]
Type=Application
Name=Atelier
Exec=$HOME/.local/share/atelier/atelier
Categories=Development;
EOF</pre>
          <p class="dl-steps-note">Se aparecer <i>"The SUID sandbox helper binary was found, but is not configured correctly"</i>, sua distribuição não permite namespaces de usuário sem privilégio:</p>
          <pre>cd ~/.local/share/atelier
sudo chown root:root chrome-sandbox
sudo chmod 4755 chrome-sandbox

<span class="rem"># ou, sem sudo:</span>
./atelier --no-sandbox</pre>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ REQUISITOS E LINKS ============ -->
  <section class="dl-more">
    <div class="wrap dl-more-grid">
      <div>
        <p class="kicker">Requisitos mínimos</p>
        <ul class="req-list">
          <li><b>macOS</b> — 12 (Monterey) ou mais recente, Apple Silicon ou Intel.</li>
          <li><b>Windows</b> — Windows 10 64-bit ou mais recente.</li>
          <li><b>Linux</b> — distribuição x64 com glibc 2.31+ (Ubuntu 20.04 ou equivalente).</li>
        </ul>
      </div>
      <div>
        <p class="kicker">Mais</p>
        <ul class="req-list">
          <li><a href={releaseNotesUrl}>Notas da versão →</a></li>
          <li><a href={`${base}/docs`}>Documentação →</a></li>
          <li><a href={`${base}/docs/primeiros-passos/primeiro-canvas`}>Seu primeiro canvas →</a></li>
        </ul>
      </div>
    </div>
  </section>

  <SiteFooter markId="dl-footer" />
</Marketing>

<script>
  // Detecção de SO só para destacar o cartão provável — os três continuam
  // sempre visíveis e clicáveis. Ninguém é redirecionado nem escondido.
  const ua = navigator.userAgent;
  let os: 'mac' | 'win' | 'linux' | null = null;
  if (/Mac OS X/.test(ua) && !/iPhone|iPad/.test(ua)) os = 'mac';
  else if (/Windows NT/.test(ua)) os = 'win';
  else if (/Linux/.test(ua) && !/Android/.test(ua)) os = 'linux';

  if (os) {
    const card = document.querySelector(`.dl-card[data-os="${os}"]`);
    card?.classList.add('dl-card-detected');
  }
</script>

<style>
  /* Botão, kicker, escala de título, `.code-window` e `.req-list` vêm de
     site.css — o mesmo vocabulário da landing. Aqui só o que é desta página. */

  .dl-hero {
    padding: 72px 0 56px;
  }
  .dl-hero .lede {
    max-width: 56ch;
    margin-bottom: 24px;
  }

  .dl-platforms {
    padding-top: 8px;
  }

  /* Sem `align-items: start`: os cartões esticam para a mesma altura, e é isso
     que faz o aviso do rodapé (com `margin-top: auto`) alinhar nas três colunas
     mesmo quando um texto é mais longo que o outro. */
  .dl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .dl-card {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-xl);
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    height: 100%;
  }

  .dl-card-detected {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 16px 40px rgb(0 0 0 / 0.35);
  }

  .dl-card-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dl-os-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--r-md);
    background: var(--surface-2);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex: none;
  }

  .dl-card-head h2 {
    font-size: 16px;
    margin: 0;
    font-weight: 650;
    letter-spacing: -0.005em;
    flex: 1;
  }

  .dl-detected-badge {
    display: none;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--r-pill);
    padding: 2px 8px;
  }
  .dl-card-detected .dl-detected-badge {
    display: inline-block;
  }

  /* O botão ocupa a largura do cartão; o texto fica centrado. */
  .dl-primary {
    width: 100%;
    justify-content: center;
  }

  .dl-soon {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .dl-size {
    font-family: var(--mono);
    font-size: 11px;
    opacity: 0.75;
  }

  .dl-secondary {
    list-style: none;
    margin: -6px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .dl-secondary li a {
    font-size: 12.5px;
    color: var(--text-dim);
  }
  .dl-secondary li a:hover {
    color: var(--text);
  }

  .dl-hash {
    margin: -4px 0 0;
    font-size: 11px;
    color: var(--text-faint);
    word-break: break-all;
  }
  .dl-hash code {
    font-family: var(--mono);
    color: var(--text-dim);
  }

  /* Empurrado para a base do cartão: as três colunas terminam alinhadas mesmo
     com avisos de tamanhos diferentes. */
  .dl-warning {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border-soft);
  }
  .dl-warning-title {
    margin: 0 0 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--amber);
  }
  .dl-warning p {
    margin: 0 0 6px;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text-dim);
  }
  .dl-warning p:last-child {
    margin-bottom: 0;
  }
  .dl-warning b {
    color: var(--text);
  }
  .dl-warning code {
    font-family: var(--mono);
    color: var(--text);
    font-size: 11.5px;
  }

  /* ---------- como instalar ---------- */

  .dl-install {
    background: var(--surface);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    padding: 72px 0;
  }
  .dl-install .section-lede {
    max-width: 68ch;
  }

  /* As três colunas na mesma linha do cartão de download correspondente acima. */
  .dl-install-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 32px;
  }

  .dl-steps h3 {
    margin: 0 0 14px;
    font-size: 15px;
    font-weight: 650;
    letter-spacing: -0.005em;
  }

  /* O contador é desenhado à mão porque o marcador nativo não aceita cor nem
     fonte próprias, e o número em mono é o que amarra a lista ao resto da
     página. */
  .dl-steps ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: passo;
  }
  .dl-steps li {
    counter-increment: passo;
    position: relative;
    padding-left: 26px;
    margin-bottom: 10px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-dim);
  }
  .dl-steps li::before {
    content: counter(passo);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
  }
  .dl-steps li b {
    color: var(--text);
    font-weight: 600;
  }

  .dl-steps-note {
    margin: 14px 0 8px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-faint);
  }

  .dl-steps code {
    font-family: var(--mono);
    color: var(--text);
    font-size: 11.5px;
  }

  /* `overflow-x` e não quebra de linha: um comando quebrado no meio vira um
     comando errado quando alguém copia. */
  /* O `.rem` existe em site.css só sob `.code-window`, e estes <pre> não estão
     dentro de um. Sem isto o comentário sai com a mesma cor do comando. */
  .dl-steps pre .rem {
    color: var(--text-faint);
  }

  /* Qual shell interpreta o bloco. Só o Windows ganha o rótulo: `cd` e `unzip`
     são os mesmos em qualquer terminal do macOS e do Linux, mas
     `Expand-Archive` só existe no PowerShell — colar no cmd.exe não funciona. */
  .dl-shell {
    margin-left: 8px;
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
