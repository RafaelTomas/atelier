---
import Marketing from '../layouts/Marketing.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

/** Base com uma barra só — `BASE_URL` varia com a config de deploy. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Marketing>
  <SiteNav sections markId="landing-nav" />

  <!-- ============ HERO ============ -->
  <div class="hero grid-bg">
    <div class="wrap hero-inner">
      <div>
        <span class="eyebrow"><span class="dot"></span>CANVAS MULTI-AGENTE &middot; LOCAL-FIRST &middot; MULTIPLATAFORMA</span>
        <h1>Seu <span class="grad">ateliê</span> de agentes de IA.</h1>
        <p class="lede">Um canvas infinito onde Claude, Codex e qualquer CLI de agente trabalham lado a lado e conversam entre si, sem você precisar copiar e colar contexto de uma janela pra outra.</p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href={`${base}/download`}>Baixar o Atelier</a>
          <a class="btn btn-ghost btn-lg" href="#como-funciona">Como funciona</a>
        </div>
      </div>

      <div class="hero-visual" id="hero-visual">
        <svg class="hv-svg" id="hero-svg">
          <defs>
            <linearGradient id="cablegrad" x1="0%" y1="0%" x2="100%" y2="100%" gradientUnits="objectBoundingBox">
              <stop offset="0" stop-color="#2E7BF6"></stop>
              <stop offset="1" stop-color="#3BD44A"></stop>
            </linearGradient>
          </defs>
          <path id="cable-main" fill="none" stroke="url(#cablegrad)" stroke-width="2.5" stroke-linecap="round"></path>
          <path id="cable-main-pulse" class="hero-cable-pulse hero-cable-pulse-1" pathLength="100" fill="none" stroke="#8fd0ff" stroke-width="2.5" stroke-linecap="round"></path>
          <path id="cable-in" fill="none" stroke="#4a4a54" stroke-width="1.4" stroke-dasharray="3 4"></path>
          <path id="cable-in-pulse" class="hero-cable-pulse hero-cable-pulse-2" pathLength="100" fill="none" stroke="#8fd0ff" stroke-width="1.4"></path>
          <path id="cable-out" fill="none" stroke="#4a4a54" stroke-width="1.4" stroke-dasharray="3 4"></path>
          <path id="cable-out-pulse" class="hero-cable-pulse hero-cable-pulse-3" pathLength="100" fill="none" stroke="#8fd0ff" stroke-width="1.4"></path>
          <circle id="cable-dot-a" r="4.5" fill="#2E7BF6"></circle>
          <circle id="cable-dot-b" r="4.5" fill="#3BD44A"></circle>
        </svg>

        <div class="node-card node-a hero-float hero-float-1" id="hero-node-claude">
          <div class="node-head"><span class="dot" style="background:#e74c3c"></span><span class="dot" style="background:#d99a2b"></span><span class="dot" style="background:#2ecc71"></span>&nbsp;Claude</div>
          <div class="node-body" data-type-on-view><span class="prompt">$</span> <span class="cmd">atelier ask "Codex" \</span><br><span class="dim">&nbsp;&nbsp;"revisa o diff em src/auth"</span></div>
        </div>

        <div class="note-card hero-float hero-float-2" id="hero-node-spec">📝 <b>Spec.md</b><br>## Requisitos<br>- login por token</div>

        <div class="node-card node-b hero-float hero-float-3" id="hero-node-codex">
          <div class="node-head"><span class="dot" style="background:#e74c3c"></span><span class="dot" style="background:#d99a2b"></span><span class="dot" style="background:#2ecc71"></span>&nbsp;Codex</div>
          <div class="node-body" data-type-on-view data-type-delay="900"><span class="prompt">$</span> <span class="cmd">atelier note read "Spec"</span><br><span class="dim">&nbsp;&nbsp;lendo requisitos…</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ PROOF STRIP ============ -->
  <div class="proof">
    <div class="wrap proof-inner">
      <div class="proof-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M8 2v4M16 2v4M3 10h18"></path></svg>
        127.0.0.1: nada sai da máquina
      </div>
      <div class="proof-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M9 21v-4h6v4"></path></svg>
        macOS · Windows · Linux
      </div>
      <div class="proof-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18l-5-6 5-6M15 6l5 6-5 6"></path></svg>
        TypeScript · React · Electron
      </div>
      <div class="proof-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l8 4-8 4-8-4z"></path><path d="M4 12l8 4 8-4M4 16l8 4 8-4"></path></svg>
        Seus dados em ~/.atelier, no seu disco
      </div>
    </div>
  </div>

  <!-- ============ O PROBLEMA ============ -->
  <section id="problema">
    <div class="wrap problem-grid">
      <div>
        <p class="kicker">O problema</p>
        <h2>Três agentes rodando ao mesmo tempo viram três janelas, e você no meio.</h2>
        <p class="section-lede">Rodar Claude, Codex e mais um agente hoje significa três terminais separados, e você virando o roteador humano: lê a saída de um, resume, cola no outro, espera, traz de volta. O trabalho de coordenação cresce mais rápido que o trabalho em si.</p>
        <p class="section-lede">O Atelier tira você desse caminho. Os agentes ficam num canvas espacial, você liga um no outro com um cabo, e eles passam a se falar direto, sem você no meio.</p>
      </div>
      <div class="term-block" data-type-on-view>
        <div><span class="who">Claude</span> $ atelier ask "Codex" "revisa o diff em src/auth"</div>
        <div><span class="who2">Codex</span>&nbsp; $ atelier note read "Spec"</div>
        <div style="color:#6b6b74;margin-top:10px">&gt; cada nó é um processo de verdade:<br>&nbsp;&nbsp;terminais são PTYs, notas são arquivos<br>&nbsp;&nbsp;.md em disco. nada é simulado.</div>
      </div>
    </div>
  </section>

  <!-- ============ COMO FUNCIONA / O CABO ============ -->
  <section id="como-funciona" class="section-tight" style="background:var(--surface);border-top:1px solid var(--border-soft);border-bottom:1px solid var(--border-soft)">
    <div class="wrap cable-feature">
      <div class="cable-visual">
        <svg viewBox="0 0 300 300" width="100%" height="100%">
          <defs>
            <linearGradient id="cg2" x1="60" y1="70" x2="240" y2="230" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#2E7BF6"></stop>
              <stop offset="1" stop-color="#3BD44A"></stop>
            </linearGradient>
          </defs>
          <path d="M0 60 H300 M0 120 H300 M0 180 H300 M0 240 H300 M60 0 V300 M120 0 V300 M180 0 V300 M240 0 V300" stroke="#26262c" stroke-width="1"></path>
          <path d="M70,80 C 140,60 150,220 235,220" fill="none" stroke="url(#cg2)" stroke-width="3" stroke-linecap="round"></path>
          <!-- Pulso: mesma curva por cima, com um traço curto que "corre" pelo
               caminho via stroke-dasharray/dashoffset animados em CSS — mais
               barato que remontar isso em JS, e para de gastar CPU sozinho
               quando a aba não está visível (a engine de animação do
               navegador já pausa @keyframes fora da viewport/tab). -->
          <path class="cable-pulse" d="M70,80 C 140,60 150,220 235,220" pathLength="100" fill="none" stroke="#8fd0ff" stroke-width="3" stroke-linecap="round"></path>
          <circle cx="70" cy="80" r="7" fill="#1b1b1f" stroke="#2E7BF6" stroke-width="2.5"></circle>
          <circle cx="235" cy="220" r="7" fill="#1b1b1f" stroke="#3BD44A" stroke-width="2.5"></circle>
          <rect x="30" y="55" width="90" height="50" rx="8" fill="#232328" stroke="#3a3a42"></rect>
          <text x="75" y="85" text-anchor="middle" fill="#ececf0" font-family="ui-monospace,monospace" font-size="11" font-weight="600">Editor</text>
          <rect x="195" y="195" width="90" height="50" rx="8" fill="#232328" stroke="#3a3a42"></rect>
          <text x="240" y="225" text-anchor="middle" fill="#ececf0" font-family="ui-monospace,monospace" font-size="11" font-weight="600">Claude</text>
        </svg>
      </div>
      <div>
        <p class="kicker">Como funciona</p>
        <h2>O cabo não é decoração. É a permissão.</h2>
        <p class="section-lede">Um agente só enxerga e conversa com aquilo em que está ligado, nunca o canvas inteiro. É o que faz o alcance de cada agente ser óbvio de olhar.</p>
        <ul class="cable-steps">
          <li><span class="step-num">1</span><span class="step-text"><b>Ligue.</b><span>Clique no ⇄ no cabeçalho de um nó, depois no destino: o cabo tracejado prende no alvo.</span></span></li>
          <li><span class="step-num">2</span><span class="step-text"><b>Peça.</b><span>"Leia a nota Spec e peça ao Codex pra revisar." O agente usa <code style="font-family:var(--mono);color:var(--text)">atelier note read</code> e <code style="font-family:var(--mono);color:var(--text)">atelier ask</code> sozinho.</span></span></li>
          <li><span class="step-num">3</span><span class="step-text"><b>Observe.</b><span>Veja os dois nós trabalharem, cada um na sua tela, sem precisar perguntar nada a ninguém.</span></span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ OS NÓS ============ -->
  <section id="nos">
    <div class="wrap">
      <p class="kicker" style="text-align:center">Os nós</p>
      <h2 style="text-align:center;max-width:36ch;margin-left:auto;margin-right:auto">Um nó para cada coisa que um agente precisa tocar</h2>
      <p class="section-lede" style="text-align:center;margin-left:auto;margin-right:auto">Nada é simulado: cada nó é um recurso de verdade (um processo, um arquivo, uma sessão de navegador) que o agente lê pelo CLI <code style="font-family:var(--mono);color:var(--text)">atelier</code>.</p>

      <div class="feat-grid" data-stagger-fade-in>
        <div class="feat-card">
          <div class="feat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M7 9l3 3-3 3M13 15h4"></path></svg></div>
          <h3>Terminal</h3>
          <p>Um PTY de verdade com xterm.js. Rode Claude, Codex ou qualquer CLI de agente.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 3h9l3 3v15H6z"></path><path d="M15 3v3h3M9 12h6M9 16h6"></path></svg></div>
          <h3>Nota</h3>
          <p>Um arquivo .md de verdade em disco, editável no canvas e lido pelos agentes pelo CLI.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 9h18"></path><circle cx="6.5" cy="7" r=".6" fill="currentColor" stroke="none"></circle></svg></div>
          <h3>Portal</h3>
          <p>Navegador embutido com sessão isolada. O agente lê, tira print e, com permissão, clica.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M8 6L2 12l6 6M16 6l6 6-6 6"></path></svg></div>
          <h3>Editor de código</h3>
          <p>O arquivo e a seleção que você está olhando agora, sem precisar contar nada pro agente.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 018 0v3"></path></svg></div>
          <h3>Cofre</h3>
          <p>Segredos criptografados em disco. O agente lê o nome da chave, nunca ecoa o valor.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M9 9v11"></path></svg></div>
          <h3>Tabela</h3>
          <p>O resultado de uma query SQL, publicado como nó: o Atelier nunca toca no banco.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="9" cy="10" r="1.7"></circle><path d="M21 16l-6-5-9 8"></path></svg></div>
          <h3>Imagem</h3>
          <p>Um gráfico, print ou diagrama, publicado direto no canvas como um nó.</p>
        </div>
        <div class="feat-card">
          <div class="feat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 4a2 2 0 014 0v6l3-1 1 1-1 6-2 2H10l-3-4V9a1.5 1.5 0 013 0"></path></svg></div>
          <h3>Botão</h3>
          <p>Um comando de um clique.</p>
          <span class="pending-chip"><span class="dot"></span>proposto por agente = pendente</span>
        </div>
        <div class="feat-card">
          <div class="feat-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M8 4v16M8 9h5M8 14h5"></path></svg></div>
          <h3>Quadro TODO</h3>
          <p>Veja o card andar de Fazendo pra Feito sem perguntar nada a ninguém.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ O ARTESÃO ============ -->
  <section id="artesao" class="artisan">
    <div class="wrap artisan-grid">
      <div>
        <span class="artisan-badge">🔨 ARTESÃO</span>
        <h2 style="margin-top:18px">Delegar não devia ser invisível.</h2>
        <p class="section-lede">Por hábito, um agente delega abrindo um subagente escondido dentro da própria sessão. No canvas isso é o pior dos dois mundos.</p>
        <div class="compare">
          <div class="compare-row bad">
            <span class="compare-tag">SUBAGENTE</span>
            <p>Sem nó, você não vê nada acontecendo. Morre junto com a sessão que o abriu, levando o que descobriu.</p>
          </div>
          <div class="compare-row good">
            <span class="compare-tag">ARTESÃO</span>
            <p>Delega abrindo nós de verdade: <code style="font-family:var(--mono)">recruit</code>, <code style="font-family:var(--mono)">ask</code>, <code style="font-family:var(--mono)">dismiss</code>. Visível, interrompível, retomável.</p>
          </div>
        </div>
        <div class="stat-row">
          <div class="stat"><b>12</b><span>terminais no teto por canvas</span></div>
          <div class="stat"><b>1</b><span>nó por agente recrutado</span></div>
          <div class="stat"><b>0</b><span>trabalho invisível</span></div>
        </div>
      </div>
      <div>
        <div class="term-block" style="background:#101014" data-type-on-view>
          <div style="color:#6b6b74">$ atelier list</div>
          <div style="margin-top:8px">→ <span class="who">Claude</span> <span style="color:#6b6b74">(você, Artesão)</span></div>
          <div>→ <span class="who2">Frontend</span> <span style="color:#6b6b74">recrutado, sonnet</span></div>
          <div>→ <span style="color:#d99a2b">Revisor</span> <span style="color:#6b6b74">recrutado, haiku</span></div>
          <div style="margin-top:14px;color:#6b6b74">$ atelier recruit "Ajudante" --model haiku</div>
          <div style="color:#2ecc71">✓ nó criado, já cabeado a você</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ REGRAS ============ -->
  <section class="section-tight">
    <div class="wrap" style="max-width:760px">
      <p class="kicker">Confiança</p>
      <h2>Cinco coisas que o Atelier nunca faz</h2>
      <p class="section-lede">Regras fixas do CLI, não sugestões que um agente pode escolher ignorar.</p>
      <ul class="rules-list">
        <li>
          <span class="rule-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6L9 17l-5-5"></path></svg></span>
          <span class="rule-text"><p><b>Nunca escreve sob um editor com alterações não salvas:</b> <span>escrever ali por baixo destruiria trabalho que ninguém revisou.</span></p></span>
        </li>
        <li>
          <span class="rule-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6L9 17l-5-5"></path></svg></span>
          <span class="rule-text"><p><b>Nunca reenvia um pedido depois de um timeout:</b> <span>só verifica o progresso e espera de novo, sem interromper quem ainda trabalha.</span></p></span>
        </li>
        <li>
          <span class="rule-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6L9 17l-5-5"></path></svg></span>
          <span class="rule-text"><p><b>Nunca propõe um botão destrutivo:</b> <span>rm, drop, reset --hard, deploy. Um clique não é deliberação suficiente pra algo irreversível.</span></p></span>
        </li>
        <li>
          <span class="rule-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6L9 17l-5-5"></path></svg></span>
          <span class="rule-text"><p><b>Nunca ecoa um segredo:</b> <span>nem na tela, nem num arquivo, nem no prompt de outro agente.</span></p></span>
        </li>
        <li>
          <span class="rule-icon"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6L9 17l-5-5"></path></svg></span>
          <span class="rule-text"><p><b>Só encerra o agente que ele mesmo recrutou:</b> <span>nunca o seu terminal, nunca o de um colega, mesmo cabeado a ele.</span></p></span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <div class="final-cta">
    <div class="wrap">
      <h2>Tire o roteador humano do meio.</h2>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={`${base}/download`}>Baixar o Atelier</a>
        <a class="btn btn-ghost btn-lg" href={`${base}/docs`}>Ler a documentação</a>
      </div>
    </div>
  </div>

  <SiteFooter markId="landing-footer" />
</Marketing>

<script>
  /**
   * Duas animações disparadas por scroll, ambas via IntersectionObserver e
   * ambas respeitando prefers-reduced-motion (mostra o resultado final direto,
   * sem espera nem movimento):
   *
   * 1. [data-type-on-view]: digita o próprio conteúdo (HTML já presente,
   *    guardado antes de esvaziar — nunca sai do DOM, então cópia de texto e
   *    leitor de tela não dependem da animação já ter rodado).
   * 2. [data-stagger-fade-in]: os filhos diretos sobem com fade em cascata,
   *    um leve atraso entre cada um.
   */
  const REDUCED_MOTION = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /**
   * Cabo do hero (Claude ⇄ Spec.md ⇄ Codex): os 3 traços são desenhados a
   * partir da posição REAL dos cartões (getBoundingClientRect), não de
   * coordenadas fixas no SVG. Coordenadas fixas quebram todo santa vez que o
   * texto de um cartão muda de tamanho (fonte, largura de coluna, tradução) e
   * os cartões — que crescem com o próprio conteúdo — deixam de coincidir com
   * os pontos hardcoded. Recalcula no load, no resize, e diretamente após
   * cada digitação (data-type-on-view muda o texto no meio, potencialmente a
   * altura do node-body).
   */
  function layoutHeroCable() {
    const container = document.getElementById('hero-visual');
    const svg = document.getElementById('hero-svg') as SVGSVGElement | null;
    const claude = document.getElementById('hero-node-claude');
    const spec = document.getElementById('hero-node-spec');
    const codex = document.getElementById('hero-node-codex');
    if (!container || !svg || !claude || !spec || !codex) return;

    const box = container.getBoundingClientRect();
    if (box.width === 0 || box.height === 0) return;

    svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);

    const rel = (el: Element) => {
      const r = el.getBoundingClientRect();
      return { left: r.left - box.left, top: r.top - box.top, right: r.right - box.left, bottom: r.bottom - box.top, width: r.width, height: r.height };
    };

    const c = rel(claude);
    const s = rel(spec);
    const x = rel(codex);

    // Ponto de saída do Claude: canto inferior direito do cartão.
    const p1 = { x: c.right - 6, y: c.bottom - 4 };
    // Ponto de entrada no Spec.md: canto superior, um pouco à esquerda do topo.
    const p2 = { x: s.left + s.width * 0.55, y: s.top + 2 };
    // Saída do Spec.md até a entrada do Codex (cabo curto tracejado).
    const p3 = { x: s.left + 12, y: s.bottom - 2 };
    const p4 = { x: x.left + 20, y: x.top + 6 };
    const p5 = { x: s.right - 10, y: s.bottom - 6 };
    const p6 = { x: x.left + x.width * 0.35, y: x.top + 2 };

    const bend = (a: { x: number; y: number }, b: { x: number; y: number }) => {
      const mx = (a.x + b.x) / 2;
      return `M${a.x},${a.y} C ${mx},${a.y} ${mx},${b.y} ${b.x},${b.y}`;
    };

    const mainPath = bend(p1, p2);
    const inPath = bend(p3, p4);
    const outPath = bend(p5, p6);

    for (const id of ['cable-main', 'cable-main-pulse']) {
      document.getElementById(id)?.setAttribute('d', mainPath);
    }
    for (const id of ['cable-in', 'cable-in-pulse']) {
      document.getElementById(id)?.setAttribute('d', inPath);
    }
    for (const id of ['cable-out', 'cable-out-pulse']) {
      document.getElementById(id)?.setAttribute('d', outPath);
    }
    document.getElementById('cable-dot-a')?.setAttribute('cx', String(p1.x));
    document.getElementById('cable-dot-a')?.setAttribute('cy', String(p1.y));
    document.getElementById('cable-dot-b')?.setAttribute('cx', String(p6.x));
    document.getElementById('cable-dot-b')?.setAttribute('cy', String(p6.y));
  }

  if (document.getElementById('hero-visual')) {
    layoutHeroCable();
    window.addEventListener('resize', layoutHeroCable);
    // Reajusta durante a digitação (o node-body pode crescer de altura
    // conforme o texto aparece) e de novo ao final, quando o HTML completo
    // (com <br>) volta a entrar.
    const heroBodies = document.querySelectorAll('#hero-node-claude [data-type-on-view], #hero-node-codex [data-type-on-view]');
    if (heroBodies.length && 'ResizeObserver' in window) {
      const ro = new ResizeObserver(() => layoutHeroCable());
      heroBodies.forEach((el) => ro.observe(el));
    }
  }

  function typeOnView(el: HTMLElement) {
    const full = el.innerHTML;
    const text = el.textContent ?? '';
    const delay = Number(el.dataset.typeDelay ?? 0);

    if (REDUCED_MOTION) return;

    el.innerHTML = '';
    el.classList.add('is-typing');

    const start = () => {
      let shown = 0;
      const timer = setInterval(() => {
        shown += 1;
        if (shown >= text.length) {
          clearInterval(timer);
          el.innerHTML = full;
          el.classList.remove('is-typing');
          return;
        }
        el.textContent = text.slice(0, shown);
      }, 40);
    };

    delay > 0 ? setTimeout(start, delay) : start();
  }

  function staggerFadeIn(container: HTMLElement) {
    if (REDUCED_MOTION) return;
    const items = Array.from(container.children) as HTMLElement[];
    items.forEach((item, i) => {
      item.classList.add('stagger-item');
      item.style.transitionDelay = `${i * 60}ms`;
      requestAnimationFrame(() => item.classList.add('stagger-in'));
    });
  }

  const typeTargets = document.querySelectorAll<HTMLElement>('[data-type-on-view]');
  const staggerTargets = document.querySelectorAll<HTMLElement>('[data-stagger-fade-in]');

  if (REDUCED_MOTION || !('IntersectionObserver' in window)) {
    // sem observer: mostra tudo já formatado, sem animação
  } else {
    const typeObserver = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          typeOnView(entry.target as HTMLElement);
          obs.unobserve(entry.target);
        }
      },
      { threshold: 0.5 }
    );
    typeTargets.forEach((el) => typeObserver.observe(el));

    const staggerObserver = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          staggerFadeIn(entry.target as HTMLElement);
          obs.unobserve(entry.target);
        }
      },
      { threshold: 0.15 }
    );
    staggerTargets.forEach((el) => staggerObserver.observe(el));
  }
</script>

